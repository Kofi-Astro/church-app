# Copy this file to backend/.env and fill in real values there.
# backend/.env is gitignored — never commit real credentials.
# See infra/infra.md for where each Supabase value comes from.

# dev | staging | prod
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=

# service_role key. Backend only — bypasses RLS. Never ship this to the
# mobile app, never log it, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# anon key. Safe for client use (RLS still applies), but the backend also
# keeps a copy so it can act as a normal RLS-scoped client where relevant.
SUPABASE_ANON_KEY=

# Phase 5 only — leave blank until the Paystack integration lands. Use a
# test-mode secret key here even then; never a live key outside prod.
PAYSTACK_SECRET_KEY=
